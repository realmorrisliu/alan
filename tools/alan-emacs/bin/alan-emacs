#!/usr/bin/env bash
set -euo pipefail

script_dir="$(realpath "$(dirname -- "${BASH_SOURCE[0]}")")"
repo_root="$(realpath "${script_dir}/..")"

config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
state_home="${XDG_STATE_HOME:-${HOME}/.local/state}"
target_dir="${config_home}/emacs"
backup_root="${state_home}/alan-emacs/backups"

usage() {
  cat <<'USAGE'
alan-emacs

Usage:
  alan-emacs doctor
  alan-emacs install
  alan-emacs update
  alan-emacs check
  alan-emacs rollback [backup-path]
  alan-emacs help
USAGE
}

timestamp() {
  date +"%Y%m%d-%H%M%S"
}

ensure_parent_dirs() {
  mkdir -p "${config_home}" "${backup_root}"
}

target_points_to_repo() {
  [[ -L "${target_dir}" ]] && [[ "$(realpath "${target_dir}")" == "${repo_root}" ]]
}

emacs_version_line() {
  emacs --version | sed -n '1p'
}

doctor() {
  echo "repo:   ${repo_root}"
  echo "target: ${target_dir}"

  if command -v emacs >/dev/null 2>&1; then
    echo "emacs:  $(emacs_version_line)"
  else
    echo "emacs:  missing from PATH"
    return 1
  fi

  if target_points_to_repo; then
    echo "config: linked to alan-emacs"
  elif [[ -L "${target_dir}" ]]; then
    echo "config: symlink to $(readlink "${target_dir}")"
  elif [[ -e "${target_dir}" ]]; then
    echo "config: existing non-symlink target"
  else
    echo "config: not installed"
  fi
}

install() {
  ensure_parent_dirs

  if target_points_to_repo; then
    echo "alan-emacs is already installed."
    return 0
  fi

  if [[ -e "${target_dir}" || -L "${target_dir}" ]]; then
    local backup_path="${backup_root}/emacs-$(timestamp)"
    if [[ -e "${backup_path}" || -L "${backup_path}" ]]; then
      backup_path="${backup_path}-$$"
    fi
    mv "${target_dir}" "${backup_path}"
    echo "Backed up existing Emacs config to ${backup_path}"
  fi

  ln -s "${repo_root}" "${target_dir}"
  echo "Installed ${target_dir} -> ${repo_root}"
  check
}

check() {
  if ! command -v emacs >/dev/null 2>&1; then
    echo "emacs is missing from PATH." >&2
    return 1
  fi

  emacs --batch -Q --load "${repo_root}/init.el" \
    --eval "(message \"alan-emacs loaded successfully\")"
}

update() {
  if ! target_points_to_repo; then
    echo "${target_dir} is not linked to ${repo_root}. Run 'alan-emacs install' first." >&2
    return 1
  fi
  check
}

latest_backup() {
  find "${backup_root}" -maxdepth 1 -mindepth 1 -name 'emacs-*' -print 2>/dev/null \
    | sort \
    | tail -n 1
}

rollback() {
  ensure_parent_dirs
  local backup_path="${1:-}"
  if [[ -z "${backup_path}" ]]; then
    backup_path="$(latest_backup || true)"
  fi
  if [[ -z "${backup_path}" || ! -e "${backup_path}" && ! -L "${backup_path}" ]]; then
    echo "No backup found under ${backup_root}." >&2
    return 1
  fi

  if [[ -e "${target_dir}" || -L "${target_dir}" ]]; then
    local current_backup="${backup_root}/emacs-current-$(timestamp)"
    mv "${target_dir}" "${current_backup}"
    echo "Moved current config to ${current_backup}"
  fi

  mv "${backup_path}" "${target_dir}"
  echo "Restored ${backup_path} to ${target_dir}"
}

command_name="${1:-help}"
shift || true

case "${command_name}" in
  doctor) doctor "$@" ;;
  install) install "$@" ;;
  update) update "$@" ;;
  check) check "$@" ;;
  rollback) rollback "$@" ;;
  help|-h|--help) usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
